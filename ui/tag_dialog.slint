// 添加自定义标签对话框：名称 + 颜色色板
import { Theme } from "theme.slint";
import { AppState } from "globals.slint";
import { LineEdit } from "std-widgets.slint";

// 色板色块：点击设为当前选中颜色，选中态描边
component ColorSwatch inherits Rectangle {
    in property <color> clr;
    in property <string> hex;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: root.clr;
    border-width: AppState.tag-dialog-color == root.hex ? 2px : 0px;
    border-color: Theme.text;
    swatch-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { AppState.tag-dialog-color = root.hex; }
    }
}

export component TagDialog inherits Rectangle {
    visible: AppState.tag-dialog-open;
    if AppState.tag-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #12223433;
        // 点击遮罩取消
        TouchArea { clicked => { AppState.tag-dialog-open = false; } }

        Rectangle {
            width: 360px;
            height: 260px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-dialog;
            background: Theme.surface;
            border-width: 1px;
            border-color: #ffffffcc;
            drop-shadow-blur: 40px;
            drop-shadow-color: #1c304a4d;
            clip: true;
            // 吞掉卡片内点击，避免穿透到遮罩
            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "添加标签";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "名称"; font-size: 12px; color: Theme.muted; }
                    name-edit := LineEdit {
                        text <=> AppState.tag-dialog-name;
                        placeholder-text: "如: 工作";
                        changed has-focus => { AppState.input-active = self.has-focus; }
                        key-pressed(ev) => {
                            if (ev.text == Key.Return) {
                                root.confirm();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "颜色"; font-size: 12px; color: Theme.muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        ColorSwatch { clr: #d13438; hex: "#d13438"; }
                        ColorSwatch { clr: #ff8c00; hex: "#ff8c00"; }
                        ColorSwatch { clr: #107c10; hex: "#107c10"; }
                        ColorSwatch { clr: #0078d4; hex: "#0078d4"; }
                        ColorSwatch { clr: #7442bd; hex: "#7442bd"; }
                        ColorSwatch { clr: #e3008c; hex: "#e3008c"; }
                        ColorSwatch { clr: #00b7c3; hex: "#00b7c3"; }
                        ColorSwatch { clr: #5d5a58; hex: "#5d5a58"; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        width: 80px; height: 34px; border-radius: 6px;
                        background: cancel-touch.has-hover ? Theme.primary-hover : Theme.surface;
                        border-width: 1px; border-color: Theme.border;
                        Text { text: "取消"; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        cancel-touch := TouchArea {
                            clicked => {
                                AppState.tag-dialog-name = "";
                                AppState.tag-dialog-open = false;
                                AppState.input-active = false;
                            }
                        }
                    }
                    Rectangle {
                        width: 80px; height: 34px; border-radius: 6px;
                        background: ok-touch.has-hover ? Theme.primary-hover : Theme.primary;
                        Text { text: "确定"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        ok-touch := TouchArea { clicked => { root.confirm(); } }
                    }
                }
            }
        }
    }

    // 确认：名称非空则提交，随后关闭并清空
    function confirm() {
        if (AppState.tag-dialog-name != "") {
            AppState.add-custom-tag(AppState.tag-dialog-name, AppState.tag-dialog-color);
        }
        AppState.tag-dialog-name = "";
        AppState.tag-dialog-color = "#0078d4";
        AppState.tag-dialog-open = false;
    }
}
